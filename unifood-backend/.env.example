# Local: copy to .env without overwriting an existing file, then run
# .\start-backend.ps1 from the monorepo root. Spring itself does not load dotenv.
# Non-empty process variables take precedence; production uses injected variables.
# Server-only; use a separate database and Auth project for each environment.
SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/unifood
SUPABASE_AUTH_ISSUER=http://localhost:54321/auth/v1
# Optional separate database credentials (never commit real values).
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Optional environment label; the application never chooses an active profile.
# SPRING_PROFILES_ACTIVE=dev

# Both URL and credential must be set together. To leave images unconfigured,
# leave BOTH empty. This public project URL is not a credential; verify the environment.
SUPABASE_STORAGE_URL=https://qcdxkmowlbptgbgjuywc.supabase.co/storage/v1
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
PRODUCT_IMAGES_CONNECT_TIMEOUT_SECONDS=5
PRODUCT_IMAGES_OPERATION_TIMEOUT_SECONDS=20
# Keep false during initial Storage checks. Enable after reviewing pending cleanup.
PRODUCT_IMAGES_CLEANUP_ENABLED=false
