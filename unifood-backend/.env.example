# Spring does NOT load this file automatically. Export variables in your shell/deployment.
# Server-only; use a separate database and Auth project for each environment.
SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/unifood
SUPABASE_AUTH_ISSUER=http://localhost:54321/auth/v1
# Optional separate database credentials (never commit real values).
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Optional environment label; the application never chooses an active profile.
# SPRING_PROFILES_ACTIVE=dev
