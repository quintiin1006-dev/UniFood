# Server-only. Explicit local backend URL; staging/production must supply their own URL.
API_URL=http://localhost:8080

# Server-only. Both required for auth and for staging/production startup/build.
# Both blank permits local UI previews with auth unavailable.
# Example URL: https://your-project.supabase.co
# Key: sb_publishable_<your-public-key> or a legacy anon JWT; never a secret/service_role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# A username such as maria resolves to maria@this-domain. Full emails work for all enabled institutions.
AUTH_USERNAME_DOMAIN=ustavillavo.edu.co
